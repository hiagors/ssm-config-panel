# Copie para `.env` e ajuste. O `.env` NÃO é versionado.

# Qual adapter de Parameter Store usar.
#   local -> LocalFileStoreAdapter, grava JSON em LOCAL_STORE_DIR (Fase 1)
#   aws   -> AwsSsmStoreAdapter, SSM real (Fase 3, ainda não implementado)
STORE_DRIVER=local

# Raiz do store local. Contém segredos em texto claro; fica no .gitignore.
LOCAL_STORE_DIR=./.local-store

# O servidor faz bind em loopback por exigência de segurança.
# Não troque HOST por 0.0.0.0.
HOST=127.0.0.1
PORT=4321

# Fase 3 (autenticação SSO): nenhuma conta, região ou nome de parâmetro é
# embutido no código. Quando chegarmos lá, o profile vem do seletor da UI,
# lido de ~/.aws/config, e a região vem do próprio profile.

# ── Backup e retenção ────────────────────────────────────────────────────────
# Antes de cada gravação, a versão anterior é copiada para BACKUP_DIR. Falha de
# backup ABORTA a gravação: sem rede de proteção, não grava.
#
# ATENÇÃO: estes arquivos contêm valor em texto claro, incluindo SecureString
# decriptado. É o único ponto do desenho que guarda em claro o que o SSM guarda
# cifrado — daí a retenção ser obrigatória.
BACKUP_DIR=./.backups

# Idade máxima de um backup, em dias. 0 desliga a poda por idade.
BACKUP_MAX_AGE_DAYS=90

# Quantidade máxima de backups por parâmetro. 0 desliga a poda por contagem.
BACKUP_MAX_VERSIONS_PER_PARAMETER=20

# O backup mais recente NUNCA é apagado, independente dos dois limites acima.
