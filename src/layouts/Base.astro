---
interface Props {
  title: string;
  driver: string;
  /** Profile em uso, quando o driver é `aws`. Nome de profile não é segredo. */
  profileName?: string | undefined;
}

const { title, driver, profileName } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Ferramenta local: nada aqui deve ser indexado nem pré-carregado. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{title} — SSM Config Panel</title>
    <style is:global>
      :root {
        --bg: #0f1115;
        --panel: #171a21;
        --border: #2a2f3a;
        --text: #e6e8ec;
        --muted: #9aa3b2;
        --accent: #5aa9ff;
        --danger: #ff6b6b;
        --ok: #4ade80;
        --warn: #fbbf24;
        --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
        --radius: 6px;
        --tree-surface: #0c0e13;
        --tree-row-header: var(--panel);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 15px/1.55 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      a {
        color: var(--accent);
      }

      h1 {
        font-size: 1.4rem;
        margin: 0 0 0.25rem;
      }

      code,
      pre {
        font-family: var(--mono);
        font-size: 13px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 1.5rem;
        background: var(--panel);
      }

      .brand {
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
        font-size: 12px;
        color: var(--muted);
      }

      .badge strong {
        color: var(--text);
        font-family: var(--mono);
      }

      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.25rem;
      }

      .muted {
        color: var(--muted);
      }

      label {
        display: block;
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 0.35rem;
      }

      input[type='text'],
      textarea {
        width: 100%;
        background: #0c0e13;
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text);
        padding: 0.55rem 0.7rem;
        font-family: var(--mono);
        font-size: 13px;
      }

      input[type='text']:focus,
      textarea:focus {
        outline: 2px solid var(--accent);
        outline-offset: -1px;
      }

      button {
        background: var(--accent);
        border: 0;
        border-radius: 6px;
        color: #06121f;
        cursor: pointer;
        font-weight: 600;
        padding: 0.55rem 0.9rem;
      }

      button.secondary {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text);
        font-weight: 500;
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      ul.parameters {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      ul.parameters li {
        border-top: 1px solid var(--border);
        padding: 0.6rem 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      ul.parameters li:first-child {
        border-top: 0;
      }

      ul.parameters a {
        font-family: var(--mono);
        font-size: 13px;
        text-decoration: none;
      }

      .notice {
        border-left: 3px solid var(--warn);
        background: #1d1a12;
        padding: 0.7rem 0.9rem;
        border-radius: 0 6px 6px 0;
        font-size: 13px;
      }

      .notice.error {
        border-left-color: var(--danger);
        background: #1f1315;
      }

      /* ── editor: grade de árvore ──────────────────────────────────────────
         UMA grid-template-columns para toda linha, em qualquer profundidade.
         Antes, cada nível de aninhamento abria um container com grid próprio
         dentro de uma largura já estreitada: a coluna de valor era recalculada
         a cada nível e, com 3 níveis, sobrava ~30px para o input.
         A profundidade agora existe só como padding-left na célula de chave.
      */

      .back-link {
        margin: 0 0 0.5rem;
      }

      .param-name {
        font-family: var(--mono);
        font-size: 1.05rem;
        word-break: break-all;
        margin: 0 0 0.5rem;
      }

      .badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.5rem 0 1rem;
      }

      .badge.dirty {
        border-color: var(--warn);
        color: var(--warn);
      }

      .secret-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        border: 1px solid var(--border);
        border-left: 3px solid var(--warn);
        background: #1d1a12;
        border-radius: 0 8px 8px 0;
        padding: 0.7rem 0.9rem;
        font-size: 13px;
        margin-bottom: 1rem;
      }

      .tabs {
        display: flex;
        gap: 0.25rem;
        margin-bottom: -1px;
      }

      button.tab {
        background: transparent;
        border: 1px solid var(--border);
        border-bottom-color: transparent;
        border-radius: 8px 8px 0 0;
        color: var(--muted);
        font-weight: 500;
        padding: 0.5rem 0.9rem;
      }

      button.tab.active {
        background: var(--panel);
        color: var(--text);
      }

      .editor-body {
        border-radius: 0 10px 10px 10px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .icon {
        flex: 0 0 auto;
        display: block;
      }

      /* ── barra de busca ─────────────────────────────────────────────────── */

      .tree-toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }

      .tree-search {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
      }

      input.search-input {
        flex: 1;
        min-width: 0;
        height: 32px;
        background: var(--tree-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text);
        padding: 0 0.6rem;
        font-family: var(--mono);
        font-size: 13px;
      }

      .search-count {
        font-size: 12px;
        color: var(--muted);
        white-space: nowrap;
      }

      button.search-clear,
      .tree-toolbar > button {
        height: 32px;
        font-size: 13px;
        white-space: nowrap;
      }

      /* ── breadcrumb ─────────────────────────────────────────────────────── */

      .breadcrumb {
        margin-bottom: 0.6rem;
      }

      .breadcrumb ol {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .breadcrumb li {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--muted);
      }

      button.crumb {
        background: transparent;
        border: 0;
        padding: 0.1rem 0.2rem;
        color: var(--accent);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
      }

      button.crumb:hover {
        text-decoration: underline;
      }

      .crumb.current {
        color: var(--text);
        font-family: var(--mono);
        font-size: 12px;
        padding: 0.1rem 0.2rem;
      }

      /* ── a grade ────────────────────────────────────────────────────────── */

      .tree {
        background: var(--tree-surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
      }

      /* A MESMA declaração para cabeçalho e para toda linha. */
      .tree-head,
      .tree-row {
        display: grid;
        grid-template-columns: 16px minmax(0, 190px) 92px minmax(0, 1fr) 56px;
        gap: 10px;
        align-items: center;
      }

      .tree-head {
        padding: 8px 12px;
        border-bottom: 1px solid var(--border);
        font-size: 11px;
        color: var(--muted);
      }

      .tree-row {
        padding: 6px 12px;
        border-bottom: 1px solid var(--border);
        min-height: 40px;
      }

      .tree-row:last-of-type {
        border-bottom: 0;
      }

      .tree-row.is-header {
        background: var(--tree-row-header);
      }

      .tree-row.is-drop-target {
        outline: 1px solid var(--accent);
        outline-offset: -1px;
      }

      .tree-empty {
        margin: 0;
        padding: 0.9rem 12px;
        font-size: 13px;
        color: var(--muted);
      }

      .tree-foot {
        display: flex;
        gap: 0.5rem;
        padding: 8px 12px;
        border-top: 1px solid var(--border);
      }

      .tree-foot button {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        height: 28px;
        font-size: 12px;
        padding: 0 0.6rem;
      }

      /* ── coluna 1: calha do grip, fora da indentação ────────────────────── */

      .tree-gutter {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      button.grip {
        background: transparent;
        border: 0;
        padding: 2px;
        color: var(--muted);
        cursor: grab;
        border-radius: 3px;
        /* Some por padrão; aparece no hover da linha E no foco por teclado —
           senão quem navega por teclado não teria pista de que dá para
           reordenar, já que arrastar não funciona por teclado. */
        opacity: 0;
        transition: opacity 90ms linear;
      }

      .tree-row:hover button.grip,
      button.grip:focus-visible {
        opacity: 1;
      }

      button.grip:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      /* ── coluna 2: chave — a ÚNICA que conhece profundidade ─────────────── */

      .tree-key {
        display: flex;
        align-items: center;
        min-width: 0;
        /* O padding-left vem inline, por nível. A borda é a guia da árvore e só
           existe a partir do primeiro nível: na raiz seria uma linha solta. */
        border-left: 1px solid transparent;
      }

      .tree-key.is-indented {
        border-left-color: var(--border);
        margin-left: 6px;
      }

      .tree-key > * {
        min-width: 0;
      }

      button.tree-disclosure {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        background: transparent;
        border: 0;
        padding: 0.2rem 0.25rem;
        color: var(--text);
        cursor: pointer;
        font-family: var(--mono);
        font-size: 13px;
        text-align: left;
        min-width: 0;
      }

      button.tree-disclosure .icon {
        color: var(--muted);
        transition: transform 90ms linear;
      }

      .tree-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: var(--mono);
        font-size: 13px;
      }

      .item-label {
        color: var(--muted);
        padding-left: 0.25rem;
      }

      .drill-hint {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0 0.35rem;
      }

      input.key-input {
        width: 100%;
        min-width: 0;
        height: 30px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text);
        padding: 0 0.45rem;
        font-family: var(--mono);
        font-size: 13px;
      }

      /* ── coluna 3: tipo ─────────────────────────────────────────────────── */

      .tree-type {
        min-width: 0;
      }

      .type-text {
        font-size: 11px;
        color: var(--muted);
      }

      .type-selector {
        width: 100%;
        height: 30px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text);
        font-size: 12px;
        padding: 0 0.2rem;
      }

      /* ── coluna 4: valor ───────────────────────────────────────────────── */

      .tree-value {
        min-width: 0;
      }

      .value-slot {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        min-width: 0;
      }

      input.value-input {
        flex: 1;
        min-width: 0;
        height: 30px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text);
        padding: 0 0.5rem;
        font-family: var(--mono);
        font-size: 13px;
      }

      input.value-input.masked {
        color: var(--muted);
        letter-spacing: 0.1em;
      }

      input.value-input.invalid,
      input.key-input.invalid {
        border-color: var(--danger);
      }

      .child-badge {
        font-size: 12px;
        color: var(--muted);
      }

      .toggle {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--text);
      }

      /* ── coluna 5: ação — dois slots de 28px ───────────────────────────── */

      .tree-actions {
        display: flex;
        align-items: center;
        gap: 0;
      }

      button.row-action {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 0;
        padding: 0;
        color: var(--muted);
        cursor: pointer;
        border-radius: 4px;
        opacity: 0;
        transition: opacity 90ms linear;
      }

      /* Revelar segredo é permanente: esconder no hover faria o usuário
         procurar o olho num campo mascarado. */
      button.row-action.reveal {
        opacity: 1;
      }

      .tree-row:hover button.row-action,
      button.row-action:focus-visible,
      .kebab-wrapper[data-open='true'] button.row-action {
        opacity: 1;
      }

      button.row-action:hover {
        color: var(--text);
      }

      button.row-action.danger:hover {
        color: var(--danger);
      }

      button.row-action:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      /* ── kebab ──────────────────────────────────────────────────────────── */

      .kebab-wrapper {
        position: relative;
        display: flex;
      }

      .kebab-menu {
        position: absolute;
        top: calc(100% + 2px);
        right: 0;
        z-index: 20;
        min-width: 12rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.25rem;
        box-shadow: 0 8px 24px rgb(0 0 0 / 45%);
      }

      .kebab-path {
        margin: 0;
        padding: 0.3rem 0.5rem;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
      }

      button.kebab-item {
        display: block;
        width: 100%;
        text-align: left;
        background: transparent;
        border: 0;
        padding: 0.4rem 0.5rem;
        color: var(--text);
        font-size: 13px;
        font-weight: 400;
        border-radius: 4px;
        cursor: pointer;
      }

      button.kebab-item:hover {
        background: var(--bg);
      }

      button.kebab-item.danger {
        color: var(--danger);
      }

      .convert-confirm {
        position: absolute;
        top: calc(100% + 2px);
        right: 0;
        z-index: 25;
        width: 19rem;
        background: var(--panel);
        border: 1px solid var(--danger);
        border-radius: 8px;
        padding: 0.75rem;
        box-shadow: 0 8px 24px rgb(0 0 0 / 45%);
      }

      .convert-confirm p {
        margin: 0 0 0.7rem;
        font-size: 13px;
      }

      .convert-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.4rem;
      }

      /* ── validação por linha ───────────────────────────────────────────── */

      .tree-issues {
        grid-column: 2 / -1;
        list-style: none;
        margin: 0.15rem 0 0;
        padding: 0;
        font-size: 12px;
      }

      .tree-issues li.error {
        color: var(--danger);
      }

      .tree-issues li.warning {
        color: var(--warn);
      }

      .raw-editor {
        width: 100%;
        min-height: 20rem;
        resize: vertical;
        background: var(--tree-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text);
        padding: 0.7rem;
        font-family: var(--mono);
        font-size: 13px;
        line-height: 1.5;
      }

      .raw-editor.invalid {
        border-color: var(--danger);
      }

      .raw-error {
        margin-top: 0;
      }

      .raw-masked {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .validation {
        margin-top: 1rem;
        font-size: 13px;
        border-left: 3px solid var(--border);
        padding: 0.6rem 0.9rem;
        border-radius: 0 6px 6px 0;
        background: var(--panel);
      }

      .validation.ok {
        border-left-color: var(--ok);
        color: var(--muted);
      }

      .validation.warn {
        border-left-color: var(--warn);
      }

      .validation.error {
        border-left-color: var(--danger);
      }

      .validation-head {
        margin: 0 0 0.4rem;
        font-weight: 600;
      }

      .validation ul {
        margin: 0;
        padding-left: 1.1rem;
      }

      .validation li.error {
        color: var(--danger);
      }

      .validation li.warning {
        color: var(--warn);
      }

      .editor-foot {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
        margin-top: 1.25rem;
      }

      .foot-note {
        font-size: 12px;
        text-align: right;
        margin: 0.5rem 0 0;
      }
      /* ── diff e conflito ──────────────────────────────────────────────── */

      .notice.success {
        border-left: 3px solid var(--ok);
        background: #101a14;
        padding: 0.7rem 0.9rem;
        border-radius: 0 6px 6px 0;
        font-size: 13px;
      }

      .review-title {
        font-size: 1rem;
        margin: 0 0 0.75rem;
      }

      .diff-summary,
      .diff-empty {
        font-size: 13px;
        color: var(--muted);
        margin: 0 0 0.75rem;
      }

      .diff-formatting {
        margin: 0;
      }

      .diff-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .diff-row {
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.5rem 0.7rem;
      }

      .diff-row.added {
        border-left: 3px solid var(--ok);
      }

      .diff-row.removed {
        border-left: 3px solid var(--danger);
      }

      .diff-row.changed {
        border-left: 3px solid var(--accent);
      }

      .diff-row.moved {
        border-left: 3px solid var(--warn);
      }

      .diff-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .diff-tag {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .diff-tag.added {
        color: var(--ok);
      }
      .diff-tag.removed {
        color: var(--danger);
      }
      .diff-tag.changed {
        color: var(--accent);
      }
      .diff-tag.moved {
        color: var(--warn);
      }

      .diff-path {
        font-size: 13px;
        word-break: break-all;
      }

      .diff-values {
        margin-top: 0.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .diff-value,
      .diff-moved {
        margin: 0;
        font-family: var(--mono);
        font-size: 12px;
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
      }

      .diff-moved {
        color: var(--warn);
        margin-top: 0.35rem;
      }

      .diff-sign {
        width: 1ch;
        color: var(--muted);
      }

      .diff-value.before .diff-sign {
        color: var(--danger);
      }
      .diff-value.after .diff-sign {
        color: var(--ok);
      }

      .diff-kind {
        color: var(--muted);
        font-size: 11px;
        min-width: 4.5rem;
      }

      .diff-text {
        word-break: break-all;
        white-space: pre-wrap;
      }

      .review-actions,
      .conflict-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
        margin-top: 1.25rem;
        flex-wrap: wrap;
      }

      .review-note,
      .conflict-hint,
      .conflict-note {
        font-size: 12px;
        margin: 0.75rem 0 0;
      }

      button.danger-action {
        border-color: var(--danger);
        color: var(--danger);
      }

      .three-way {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        margin-top: 0.75rem;
        display: block;
        overflow-x: auto;
      }

      .three-way th,
      .three-way td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.5rem;
        text-align: left;
        vertical-align: top;
      }

      .three-way th {
        color: var(--muted);
        font-weight: 500;
        white-space: nowrap;
      }

      .three-way-row.both {
        background: #1f1315;
      }

      .side-tag {
        display: inline-block;
        margin-left: 0.4rem;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .side-tag.both {
        color: var(--danger);
      }
      .side-tag.theirs {
        color: var(--warn);
      }
      .side-tag.mine {
        color: var(--accent);
      }

      /* ── seletor de profile e tela inicial ────────────────────────────── */

      .topbar-meta {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .profile-selector label {
        margin-bottom: 0.35rem;
      }

      .profile-select {
        width: 100%;
        font-family: var(--mono);
        font-size: 13px;
        padding: 0.5rem;
      }

      .profile-detail {
        margin-top: 0.75rem;
      }

      .badge.session-ok {
        border-color: var(--ok);
        color: var(--ok);
      }

      .badge.session-bad {
        border-color: var(--warn);
        color: var(--warn);
      }

      .profile-login {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
        margin-top: 0.5rem;
      }

      .profile-login p {
        margin: 0;
        font-size: 13px;
      }

      .row {
        display: flex;
        gap: 0.6rem;
      }

      .hint {
        margin: 0.6rem 0 0;
        font-size: 12px;
      }

      .list-meta {
        font-size: 12px;
      }

      .foot-notice {
        margin-top: 1rem;
        font-size: 13px;
      }

      /* ── banner de sessão expirada e toolbar do JSON cru ──────────────── */

      .session-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        border: 1px solid var(--border);
        border-left: 3px solid var(--warn);
        background: #1d1a12;
        border-radius: 0 8px 8px 0;
        padding: 0.75rem 0.9rem;
        font-size: 13px;
        margin-bottom: 1rem;
      }

      .session-banner-text {
        flex: 1;
        min-width: 14rem;
      }

      .session-banner .notice {
        flex-basis: 100%;
      }

      .raw-toolbar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.6rem;
      }

      .raw-hint {
        font-size: 12px;
      }

      .raw-editor.is-pretty {
        color: var(--muted);
        border-style: dashed;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <span class="brand">SSM Config Panel</span>
      <span class="topbar-meta">
        {
          profileName && (
            <span class="badge">
              profile <strong>{profileName}</strong>
            </span>
          )
        }
        <span class="badge">driver <strong>{driver}</strong></span>
      </span>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
