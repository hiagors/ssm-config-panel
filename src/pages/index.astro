---
import Base from '../layouts/Base.astro';
import HomeControls from '../components/HomeControls.tsx';
import { ListParametersUseCase } from '../application/ListParametersUseCase.js';
import { ListProfilesUseCase } from '../application/ListProfilesUseCase.js';
import {
  getSsoAuth,
  preselectedProfileName,
  resolveDriver,
  resolveParameterStore,
} from '../infrastructure/store/index.js';
import { isAppError } from '../domain/errors.js';
import type { ParameterMetadata } from '../domain/Parameter.js';
import type { AwsProfile } from '../domain/AwsProfile.js';

export const prerender = false;

const driver = resolveDriver();

/**
 * A tela inicial muda de forma conforme o driver.
 *
 * No local, listar tudo é barato e útil. No `aws`, é preciso escolher profile
 * e buscar por prefixo — `DescribeParameters` numa conta de produção é paginado
 * e sujeito a throttling. Renderizar a lista completa no SSR faria a página
 * inicial esperar por uma varredura.
 */
let profiles: AwsProfile[] = [];
let profilesError: string | undefined;
let preselected: string | undefined;

if (driver === 'aws') {
  try {
    const result = await new ListProfilesUseCase(getSsoAuth()).execute(preselectedProfileName());
    profiles = [...result.profiles];
    preselected = result.preselected;
  } catch (error) {
    profilesError = isAppError(error)
      ? error.publicMessage
      : 'Não foi possível ler os profiles de ~/.aws/config.';
  }
}

let localParameters: ParameterMetadata[] = [];
let localListError: string | undefined;

if (driver === 'local') {
  try {
    const store = await resolveParameterStore({ driver, profileName: undefined });
    localParameters = await new ListParametersUseCase(store).execute();
  } catch (error) {
    localListError = isAppError(error)
      ? error.publicMessage
      : 'Não foi possível listar os parâmetros.';
  }
}
---

<Base title="Parâmetros" driver={driver}>
  <h1>Parâmetros</h1>
  <p class="muted">
    {
      driver === 'aws'
        ? 'Escolha o profile, garanta a sessão válida e abra um parâmetro pelo name ou pela busca por prefixo.'
        : 'Informe o name de um parâmetro ou escolha um da lista do store local.'
    }
  </p>

  {profilesError && <p class="notice error">{profilesError}</p>}

  {
    driver === 'aws' && (
      <p class="notice">
        <strong>Gravação habilitada.</strong> Toda escrita passa por diff com confirmação, recheque
        de versão no servidor, e backup da versão anterior em <code>./.backups</code> — falha de
        backup aborta a gravação.
      </p>
    )
  }

  <HomeControls
    driver={driver}
    initialProfiles={profiles}
    initialPreselected={preselected}
    localParameters={localParameters}
    localListError={localListError}
    client:load
  />
</Base>
